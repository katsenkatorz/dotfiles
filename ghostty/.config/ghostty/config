#~~~~~~~~~~~~~~~~~~~~~~~#
# Ghostty configuration #
#~~~~~~~~~~~~~~~~~~~~~~~#
shell-integration = fish
desktop-notifications = true
# First window at launch joins the last tuios session; later tabs stay plain fish.
initial-command = /opt/homebrew/bin/fish -l -c "exec /opt/homebrew/bin/tuios attach"

#~~~~~~~~~~~~~~~~~~~~~~~#
#theme
#~~~~~~~~~~~~~~~~~~~~~~~#
theme = Catppuccin Mocha
# Slapeo app background, overrides the theme's base
background = #0F0A1C
font-family = FiraCode
font-size = 14

window-padding-x = 10
window-padding-y = 10

# Surcharge pour améliorer la lisibilité des erreurs Symfony
# Rouge plus foncé pour le fond des erreurs
palette = 1=#DC2626
# Rouge vif pour les erreurs normales
palette = 9=#EF4444

#~~~~~~~~~~~~~~~~~~~~~~~#
#quick-term
#~~~~~~~~~~~~~~~~~~~~~~~#
quick-terminal-position = bottom
quick-terminal-space-behavior = remain
quick-terminal-screen = mouse

#~~~~~~~~~~~~~~~~~~~~~~~#
#keybind
#~~~~~~~~~~~~~~~~~~~~~~~#
keybind = global:opt+space=toggle_quick_terminal
