#!/bin/bash

# JankyBorders config, read by `borders` when launched without arguments
# (brew services start felixkratz/formulae/borders).
# Sonokai palette (FelixKratz dotfiles).

# order=below keeps Mission Control animations clean (above-borders lag
# behind the window snapshots). The native 1px outline stays visible but
# blends with the off-white active color of this palette.
options=(
  style=round
  width=5.0
  order=below
  hidpi=on
  active_color=0xffe2e2e3
  inactive_color=0xff414550
)

borders "${options[@]}"
