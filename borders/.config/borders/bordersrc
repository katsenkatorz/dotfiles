#!/bin/bash

# JankyBorders config, read by `borders` when launched without arguments
# (brew services start felixkratz/formulae/borders).
# Sonokai palette, aligned with the SketchyBar config (FelixKratz dotfiles).

# order=above draws the border on top of the window: its inner half overlaps
# the window edge and hides the native macOS 1px outline; opaque colors
# (alpha ff) keep it hidden on unfocused windows too.
options=(
  style=round
  width=5.0
  order=above
  hidpi=on
  active_color=0xffe2e2e3
  inactive_color=0xff414550
)

borders "${options[@]}"
