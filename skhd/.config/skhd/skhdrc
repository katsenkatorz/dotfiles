# skhd bindings for yabai, i3/vim style on alt.
# Space focus/move need yabai's scripting addition (SIP partially disabled);
# the `|| skhd -k` fallback synthesizes the native ctrl+N Mission Control
# shortcut, which must be enabled in System Settings > Keyboard > Shortcuts.

# Focus window (vim keys)
alt - h : yabai -m window --focus west
alt - j : yabai -m window --focus south
alt - k : yabai -m window --focus north
alt - l : yabai -m window --focus east

# Swap window
shift + alt - h : yabai -m window --swap west
shift + alt - j : yabai -m window --swap south
shift + alt - k : yabai -m window --swap north
shift + alt - l : yabai -m window --swap east

# Fullscreen: zoom inside the layout, or native macOS fullscreen
alt - f : yabai -m window --toggle zoom-fullscreen
shift + alt - f : yabai -m window --toggle native-fullscreen

# Toggle float (centered 2x2 on a 4x4 grid)
alt - t : yabai -m window --toggle float --grid 4:4:1:1:2:2

# Layout tweaks
shift + alt - r : yabai -m space --rotate 270
shift + alt - 0 : yabai -m space --balance
alt - e : yabai -m window --toggle split

# Resize
ctrl + alt - h : yabai -m window --resize left:-40:0 || yabai -m window --resize right:-40:0
ctrl + alt - l : yabai -m window --resize right:40:0 || yabai -m window --resize left:40:0
ctrl + alt - k : yabai -m window --resize top:0:-40 || yabai -m window --resize bottom:0:-40
ctrl + alt - j : yabai -m window --resize bottom:0:40 || yabai -m window --resize top:0:40

# Focus space N (scripting addition, else native ctrl+N fallback)
alt - 1 : yabai -m space --focus 1 || skhd -k "ctrl - 1"
alt - 2 : yabai -m space --focus 2 || skhd -k "ctrl - 2"
alt - 3 : yabai -m space --focus 3 || skhd -k "ctrl - 3"
alt - 4 : yabai -m space --focus 4 || skhd -k "ctrl - 4"
alt - 5 : yabai -m space --focus 5 || skhd -k "ctrl - 5"
alt - 6 : yabai -m space --focus 6 || skhd -k "ctrl - 6"

# Send window to space N and follow (scripting addition only)
shift + alt - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + alt - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + alt - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + alt - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + alt - 5 : yabai -m window --space 5; yabai -m space --focus 5
shift + alt - 6 : yabai -m window --space 6; yabai -m space --focus 6
