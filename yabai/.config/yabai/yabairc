#!/usr/bin/env sh

# Scripting addition: needs partial SIP disable + the sudoers entry pinning
# the yabai binary hash (regenerate it after every yabai upgrade).
# The Dock signal reloads it whenever macOS restarts the Dock process.
sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# BSP tiling. SketchyBar owns the top 36pt (external_bar), JankyBorders
# owns the borders, so opacity/shadow tricks stay off.

yabai -m config layout bsp
yabai -m config window_placement second_child
yabai -m config external_bar all:36:0

yabai -m config top_padding 8
yabai -m config bottom_padding 8
yabai -m config left_padding 8
yabai -m config right_padding 8
yabai -m config window_gap 8

yabai -m config mouse_follows_focus off
yabai -m config focus_follows_mouse off
yabai -m config mouse_modifier alt
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action swap

# Apps that make no sense tiled
yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Karabiner-EventViewer$" manage=off
yabai -m rule --add app="^Archive Utility$" manage=off

# Games: never tiled, never moved
yabai -m rule --add app="^(Steam|Battle\.net|World of Warcraft|Diablo III|CurseForge)$" manage=off

# One space per usage on the main display (spaces created manually:
# space creation through the scripting addition is broken on this macOS)
yabai -m rule --add app="^Arc$" space=1
yabai -m rule --add app="^Ghostty$" space=2
yabai -m rule --add app="^(PhpStorm|WebStorm|Xcode)$" space=3
yabai -m rule --add app="^(Discord|Telegram|Microsoft Teams)$" space=4
yabai -m rule --add app="^(Figma|Obsidian)$" space=5

echo "yabai configuration loaded"
